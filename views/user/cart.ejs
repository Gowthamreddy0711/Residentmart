<% layout("layouts/boilerplate") %>

<style>

.cart-card{
  border-radius:20px;
  overflow:hidden;
  border:none;
  transition:0.3s;
}

.cart-card:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 25px rgba(0,0,0,0.08);
}

.cart-image{
  width:110px;
  height:110px;
  object-fit:contain;
  background:#f8fafc;
  border-radius:16px;
  padding:10px;
}

.qty-box{
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:#22c55e;
  border-radius:12px;
  overflow:hidden;
  width:140px;
  height:45px;
}

.qty-btn{
  width:40px;
  height:100%;
  border:none;
  background:transparent;
  color:white;
  font-size:22px;
  font-weight:bold;
}

.qty-number{
  width:50px;
  height:100%;
  background:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
}

.remove-btn{
  border-radius:10px;
}

.total-card{
  border:none;
  border-radius:20px;
}

</style>

<div class="container py-4">

  <h2 class="fw-bold mb-4">

    🛒 Your Cart

  </h2>

  <% let total = 0; %>

  <% if(cartItems.length === 0){ %>

    <div
      class="
        bg-white
        p-5
        rounded-4
        shadow-sm
        text-center
      "
    >

      <img
        src="https://cdn-icons-png.flaticon.com/512/2038/2038854.png"
        width="160"
        class="mb-4"
      >

      <h3 class="fw-bold">
        Your Cart is Empty
      </h3>

      <p class="text-muted">

        Add some products to continue shopping

      </p>

      <a
        href="/products"
        class="
          btn
          btn-success
          rounded-pill
          px-4
        "
      >

        Browse Products

      </a>

    </div>

  <% } %>

  <% cartItems.forEach(item => { %>

    <%

      const product = item.product;

      const itemTotal =
        item.price *
        item.cartQuantity;

      total += itemTotal;

    %>

    <div
      class="
        card
        cart-card
        shadow-sm
        mb-4
      "
    >

      <div
        class="
          card-body
          d-flex
          align-items-center
          flex-wrap
          gap-3
        "
      >

        <!-- IMAGE -->

        <img
          src="<%= product.image %>"
          class="cart-image"
        >

        <!-- PRODUCT INFO -->

        <div class="flex-grow-1">

          <h5 class="fw-bold mb-1">

            <%= product.name %>
        </div>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-danger decrease-btn" data-id="<%= item.product._id %>" data-pack="<%= item.pack %>">-</button>
      <span id="qty-<%= item.product._id %>-<%= item.pack %>"><%= item.cartQuantity %></span>
      <button class="btn btn-success increase-btn" data-id="<%= item.product._id %>" data-pack="<%= item.pack %>">+</button>
    </div>

          </h5>

          <p class="text-muted mb-1">

            <%= item.pack %>

          </p>

          <h5 class="text-success fw-bold">

            ₹<%= item.price %>

          </h5>

          <small class="text-muted">

            Total:
            ₹<%= itemTotal.toFixed(2) %>

          </small>

        </div>

        <!-- QUANTITY CONTROLS -->

        <div>

          <div class="qty-box">

            <!-- MINUS -->

            <button
              type="button"
              class="
                qty-btn
                qty-minus
              "
              data-id="<%= product._id %>"
            >

              −

            </button>

            <!-- COUNT -->

            <div
              class="
                qty-number
                qty-input
              "
            >

              <%= item.cartQuantity %>

            </div>

            <!-- PLUS -->

            <button
              type="button"
              class="
                qty-btn
                qty-plus
              "
              data-id="<%= product._id %>"
            >

              +

            </button>

          </div>

          <!-- REMOVE -->

          <button
            type="button"
            class="
              btn
              btn-outline-danger
              w-100
              mt-2
              remove-btn
            "
            data-id="<%= product._id %>"
          >

            Remove

          </button>

        </div>

      </div>

    </div>

  <% }) %>

  <% if(cartItems.length > 0){ %>

    <!-- TOTAL CARD -->

    <div
      class="
        card
        total-card
        shadow-sm
        p-4
        mt-4
      "
    >

      <div
        class="
          d-flex
          justify-content-between
          align-items-center
        "
      >

        <h3 class="fw-bold">

          Grand Total

        </h3>

        <h3 class="text-success fw-bold">

          ₹<%= total.toFixed(2) %>

        </h3>

      </div>

      <form
        action="/order"
        method="POST"
      >

        <button
          class="
            btn
            btn-success
            w-100
            mt-4
            py-3
            rounded-3
          "
        >

          Proceed to Checkout

        </button>

      </form>

    </div>

  <% } %>

</div>

<script>

// ================= PLUS =================

document.querySelectorAll(
  ".qty-plus"
).forEach(btn => {

  btn.addEventListener(
    "click",
    async () => {

      const productId =
        btn.dataset.id;

      await fetch(
        `/cart/increase/${productId}`,
        {
          method:"POST"
        }
      );

      location.reload();

    }
  );

});

// ================= MINUS =================

document.querySelectorAll(
  ".qty-minus"
).forEach(btn => {

  btn.addEventListener(
    "click",
    async () => {

      const productId =
        btn.dataset.id;

      await fetch(
        `/cart/decrease/${productId}`,
        {
          method:"POST"
        }
      );

      location.reload();

    }
  );

});

// ================= INCREASE =================
document.querySelectorAll(".increase-btn").forEach((btn) => {
  btn.addEventListener("click", async () => {
    const id = btn.dataset.id;
    const pack = btn.dataset.pack;
    const res = await fetch(`/cart/increase/${id}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ pack }),
    });
    const data = await res.json();
    document.getElementById(`qty-${id}-${pack}`).innerText = data.quantity;
    document.getElementById("cart-count").innerText = data.cartCount;
  });
});
// ================= DECREASE =================
document.querySelectorAll(".decrease-btn").forEach((btn) => {
  btn.addEventListener("click", async () => {
    const id = btn.dataset.id;
    const pack = btn.dataset.pack;
    const res = await fetch(`/cart/decrease/${id}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ pack }),
    });
    const data = await res.json();
    if (data.quantity === 0) {
      location.reload();
      return;
    }
    document.getElementById(`qty-${id}-${pack}`).innerText = data.quantity;
    document.getElementById("cart-count").innerText = data.cartCount;
  });
});

      const productId =
        btn.dataset.id;

      await fetch(
        `/cart/remove/${productId}`,
        {
          method:"POST"
        }
      );

      location.reload();

    }
  );

});

</script>